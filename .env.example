# مرجع متغيرات البيئة — انسخ القيم من ملف .env المحلي أو من لوحة التحكم
# يُستخدم في Vercel ← Settings ← Environment Variables (ثم Redeploy)

# ── Firebase (مشروع واحد للكاشير واللوحة) ──
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=my-system-admin.firebaseapp.com
VITE_FB_PROJECT_ID=my-system-admin
VITE_FB_APP_ID=1:374790599531:web:0b22b9db833219122b122e

# ── الترخيص ──
VITE_LIC_APP_ID=1374790599531web0b22b9db833219122b122e
VITE_LIC_APP_NAME=نظام نقاط البيع والمبيعات (POS)
VITE_LIC_WHATSAPP=972592133357

# المفتاح العام JWK — انسخه من اللوحة: /admin ← المفاتيح ← "نسخ"
# مهم: يجب أن يطابق المفتاح الخاص المحفوظ في متصفحك، وإلا فشلت كل التوكنات
VITE_LIC_PUBLIC_KEY='{"crv":"P-256","ext":true,"key_ops":["verify"],"kty":"EC","x":"...","y":"..."}'
